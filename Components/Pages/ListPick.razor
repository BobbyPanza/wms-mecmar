@page "/pick/list"

@using System.Globalization
@inject SessionService Session
@inject PickListService PickSvc
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject NavigationManager Nav

<PageTitle>Prelievo da Lista</PageTitle>

@if (_list is null)
{
    @* ─── Selezione lista ──────────────────────────────────────────────────── *@
    <MudText Typo="Typo.h6" Class="mb-3">Prelievo da Lista</MudText>
    <BarcodeInput Label="Scan bolla / codice lista" OnCodeScanned="OnListBarcode" AutoFocus="true" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
    }
    else
    {
        @foreach (var h in _lists)
        {
            var pct = h.TotalRows > 0 ? (double)h.CompletedRows / h.TotalRows * 100 : 0;
            <MudPaper Elevation="2" Class="pa-3 mb-2" Style="border-radius:10px;cursor:pointer;"
                      @onclick="() => OpenList(h)">
                <div class="d-flex justify-space-between align-start">
                    <div style="min-width:0;flex:1;">
                        <MudText Style="font-family:monospace;font-weight:700;">@h.Code</MudText>
                        <MudText Typo="Typo.caption" Style="color:#94A3B8;">@h.Description</MudText>
                        @if (h.OlCods.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Style="color:#64748B;">
                                Bolle: @string.Join(", ", h.OlCods)
                            </MudText>
                        }
                    </div>
                    <div class="d-flex flex-column align-end gap-1">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(h.Status == "InProgress" ? Color.Warning : Color.Default)">
                            @(h.Status == "InProgress" ? "In corso" : "Aperta")
                        </MudChip>
                        @if (h.MissingRows > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">
                                @h.MissingRows mancanti
                            </MudChip>
                        }
                    </div>
                </div>
                <MudProgressLinear Value="@pct" Color="Color.Success"
                                   Rounded="true" Size="Size.Small" Class="mt-2" />
                <MudText Typo="Typo.caption" Style="color:#94A3B8;" Class="mt-1">
                    @h.CompletedRows / @h.TotalRows completati
                </MudText>
            </MudPaper>
        }

        @if (_lists.Count == 0 && !_loading)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                Nessuna lista aperta. Scansiona il codice bolla per crearne una.
            </MudAlert>
        }
    }
}
else
{
    @* ─── Lista righe ──────────────────────────────────────────────────────── *@
    <div class="d-flex align-center mb-2 gap-2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                       OnClick="CloseList" />
        <div style="flex:1;min-width:0;">
            <MudText Style="font-family:monospace;font-weight:700;font-size:.95rem;">
                @_list.Code
            </MudText>
            <MudText Typo="Typo.caption" Style="color:#94A3B8;">@_list.Description</MudText>
        </div>
    </div>

    @* Toolbar: sort + switch *@
    <MudPaper Class="pa-2 mb-2" Style="border-radius:8px;background:#242e42;">
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudSelect T="PickSortField" @bind-Value="_sortField"
                       Label="Ordina" Dense="true" Variant="Variant.Outlined"
                       Style="min-width:160px;max-width:200px;">
                <MudSelectItem Value="PickSortField.ArticleCode">Codice articolo</MudSelectItem>
                <MudSelectItem Value="PickSortField.Handling">Tipo handling</MudSelectItem>
                <MudSelectItem Value="PickSortField.IdSpec">IDSpec</MudSelectItem>
                <MudSelectItem Value="PickSortField.IdGroup">IDGroup</MudSelectItem>
                <MudSelectItem Value="PickSortField.MainLocation">Locazione principale</MudSelectItem>
            </MudSelect>
            <MudSpacer />
            <MudSwitch @bind-Value="_hideCompleted" Color="Color.Primary" Size="Size.Small"
                       Label="Nascondi completate" />
        </div>
    </MudPaper>

    <BarcodeInput Label="Scan articolo" OnCodeScanned="OnArticleBarcode" AutoFocus="true" />

    @foreach (var row in SortedRows)
    {
        var (bg, border) = RowStyle(row);
        <MudPaper Elevation="1" Class="@($"pa-3 mb-2 {border}")"
                  Style="@($"border-radius:8px;background:{bg};cursor:pointer;")"
                  @onclick="() => OpenRowDialog(row)">
            <div class="d-flex align-start justify-space-between">
                <div style="min-width:0;flex:1;">
                    <div class="d-flex align-center gap-1">
                        <MudText Style="font-weight:700;font-family:monospace;font-size:.9rem;">
                            @row.ArticleCode
                        </MudText>
                        <ArticleInfoButton ArticleCode="@row.ArticleCode" />
                        @if (!row.HasStock && row.StagingStatus == StagingStatus.Pending)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning"
                                     Color="Color.Error" Size="Size.Small" />
                        }
                    </div>
                    <MudText Typo="Typo.caption" Style="color:#94A3B8;word-break:break-word;">
                        @row.ArticleDesc
                    </MudText>
                    <div class="d-flex gap-1 mt-1 flex-wrap">
                        @if (!string.IsNullOrEmpty(row.MainLocationCode))
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.LocationOn"
                                     Color="Color.Primary">
                                @row.MainLocationCode
                            </MudChip>
                        }
                        @if (!string.IsNullOrEmpty(row.Handling))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                @row.Handling
                            </MudChip>
                        }
                        @if (row.IsExtraItem)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                Extra
                            </MudChip>
                        }
                    </div>
                </div>
                <div class="d-flex flex-column align-end ml-2" style="min-width:64px;">
                    @switch (row.StagingStatus)
                    {
                        case StagingStatus.Done:
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                            break;
                        case StagingStatus.Missing:
                            <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" />
                            break;
                        default:
                            <MudText Style="font-weight:700;color:#5B9BD5;white-space:nowrap;font-size:.85rem;">
                                @Fmt(row.TotalCoveredQty) / @Fmt(row.PlannedQty)
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color:#94A3B8;">@row.UoM</MudText>
                            break;
                    }
                </div>
            </div>
        </MudPaper>
    }

    @* Bottom action bar *@
    <div class="d-flex gap-2 mt-3">
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddExtraRowDialog"
                   Style="flex:1;">
            Aggiungi riga
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.SelectAll"
                   Disabled="@_executing"
                   OnClick="PrelevaTutto"
                   Style="flex:1;">
            Preleva tutto
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(_executing || !HasStagedPicks)"
                   OnClick="FaiPrelievi"
                   Style="flex:1;">
            @if (_executing)
            { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
            else
            { <span>Fai prelievi</span> }
        </MudButton>
    </div>
}

@code {
    // ─── State ────────────────────────────────────────────────────────────────

    private List<PickListHeaderDto> _lists  = [];
    private PickListHeaderDto?      _list;
    private List<PickListRowDto>    _rows   = [];
    private PickSortField           _sortField = PickSortField.Handling;
    private bool _hideCompleted = true;
    private bool _loading;
    private bool _executing;

    private bool HasStagedPicks =>
        _rows.Any(r => r.Picks.Any(p => !p.IsExecuted));

    private IEnumerable<PickListRowDto> SortedRows
    {
        get
        {
            var rows = _rows.AsEnumerable();
            if (_hideCompleted)
                rows = rows.Where(r => r.StagingStatus != StagingStatus.Done);
            // Mancanti sempre in fondo
            rows = _sortField switch
            {
                PickSortField.Handling     => rows.OrderBy(r => r.IsMissing)
                                                  .ThenBy(r => r.Handling)
                                                  .ThenBy(r => r.ArticleCode),
                PickSortField.IdSpec       => rows.OrderBy(r => r.IsMissing)
                                                  .ThenBy(r => r.IdSpec)
                                                  .ThenBy(r => r.ArticleCode),
                PickSortField.IdGroup      => rows.OrderBy(r => r.IsMissing)
                                                  .ThenBy(r => r.IdGroup)
                                                  .ThenBy(r => r.ArticleCode),
                PickSortField.MainLocation => rows.OrderBy(r => r.IsMissing)
                                                  .ThenBy(r => r.MainLocationCode)
                                                  .ThenBy(r => r.ArticleCode),
                _                          => rows.OrderBy(r => r.IsMissing)
                                                  .ThenBy(r => r.ArticleCode),
            };
            return rows;
        }
    }

    // ─── Init ─────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        Session.SetPageTitle("Prelievo da Lista");
        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        _loading = true;
        try   { _lists = await PickSvc.GetPickListsAsync(); }
        catch { Snackbar.Add("Errore caricamento liste", Severity.Error); }
        _loading = false;
    }

    // ─── Selezione lista ──────────────────────────────────────────────────────

    private async Task OnListBarcode(string code)
    {
        var existing = _lists.FirstOrDefault(l =>
            l.Code.Equals(code.Trim(), StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            await OpenList(existing);
            return;
        }

        // Prova a creare la lista dalla bolla
        _loading = true;
        StateHasChanged();
        try
        {
            var id = await PickSvc.LoadListFromOlCodAsync(code.Trim(), Session.OperatorCode!);
            await LoadListsAsync();
            var created = _lists.FirstOrDefault(l => l.Id == id);
            if (created is not null) await OpenList(created);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        _loading = false;
    }

    private async Task OpenList(PickListHeaderDto h)
    {
        _list = h;
        Session.SetPageTitle(h.Code);
        Session.SetPrintContext("PICK", new() { ["LISTCODE"] = h.Code });
        await RefreshRowsAsync();
    }

    private async Task RefreshRowsAsync()
    {
        try   { _rows = await PickSvc.GetPickListDetailAsync(_list!.Id); }
        catch { Snackbar.Add("Errore caricamento righe", Severity.Error); }
    }

    private async Task CloseList()
    {
        _list = null;
        _rows = [];
        Session.ClearPrintContext();
        await LoadListsAsync();
    }

    // ─── Barcode articolo ─────────────────────────────────────────────────────

    private async Task OnArticleBarcode(string code)
    {
        var row = _rows.FirstOrDefault(r =>
            r.ArticleCode.Equals(code.Trim(), StringComparison.OrdinalIgnoreCase));
        if (row is null)
        {
            Snackbar.Add($"{code}: non trovato in lista", Severity.Warning);
            return;
        }
        await OpenRowDialog(row);
    }

    // ─── Dialog articolo ─────────────────────────────────────────────────────

    private async Task OpenRowDialog(PickListRowDto row)
    {
        var param = new DialogParameters<PickRowDialog>
        {
            { x => x.Row,          row          },
            { x => x.OperatorCode, Session.OperatorCode! }
        };
        var opt = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dlg = await Dialog.ShowAsync<PickRowDialog>(row.ArticleCode, param, opt);
        if ((await dlg.Result) is { Canceled: false })
            await RefreshRowsAsync();
    }

    // ─── Preleva tutto ────────────────────────────────────────────────────────

    private async Task PrelevaTutto()
    {
        _executing = true;
        try
        {
            await PickSvc.StageAllFromMainAsync(_list!.Id, Session.OperatorCode!);
            await RefreshRowsAsync();
            Snackbar.Add("Pick staged dalla locazione principale per tutti gli articoli disponibili",
                         Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _executing = false;
    }

    // ─── Fai prelievi ─────────────────────────────────────────────────────────

    private async Task FaiPrelievi()
    {
        var dlgConf = await Dialog.ShowAsync<ConfirmDialog>("Conferma prelievi",
            new DialogParameters<ConfirmDialog>
            {
                { x => x.Message, "Eseguire tutti i prelievi staged? I movimenti verranno scritti sul gestionale." }
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if ((await dlgConf.Result)?.Canceled == true) return;

        _executing = true;
        try
        {
            var (ok, errors) = await PickSvc.ExecuteStagedPicksAsync(
                _list!.Id, Session.OperatorCode!, Session.NodeId);

            if (errors.Count > 0)
            {
                foreach (var e in errors)
                    Snackbar.Add(e, Severity.Error);
            }
            if (ok > 0)
                Snackbar.Add($"{ok} prelievo/i registrat{(ok == 1 ? "o" : "i")} su ERP",
                             Severity.Success);

            await RefreshRowsAsync();
            // Aggiorna anche la testata
            var updated = await PickSvc.GetPickListsAsync();
            _list = updated.FirstOrDefault(l => l.Id == _list!.Id) ?? _list;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _executing = false;
    }

    // ─── Aggiungi riga extra ──────────────────────────────────────────────────

    private async Task AddExtraRowDialog()
    {
        var param = new DialogParameters<AddExtraRowDialog>
        {
            { x => x.AvailableOlCods, _list!.OlCods }
        };
        var opt = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dlg = await Dialog.ShowAsync<AddExtraRowDialog>("Aggiungi riga", param, opt);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: AddExtraRowResult r })
        {
            try
            {
                await PickSvc.AddExtraRowAsync(_list!.Id, r.ArticleCode, r.PlannedQty,
                                               r.OlCod, Session.OperatorCode!);
                await RefreshRowsAsync();
                Snackbar.Add($"{r.ArticleCode} aggiunto alla lista", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    // ─── Helpers ─────────────────────────────────────────────────────────────

    private static string Fmt(decimal q) => q.ToString("0.###", CultureInfo.CurrentCulture);

    private static (string Bg, string BorderClass) RowStyle(PickListRowDto row) =>
        row.StagingStatus switch
        {
            StagingStatus.Done    => ("#1e2d20", "pick-row-done"),
            StagingStatus.Partial => ("#2d2a10", "pick-row-partial"),
            StagingStatus.Missing => ("#2d1e1e", "pick-row-missing"),
            _                     => ("#1e2a40", "pick-row-pending")
        };
}
