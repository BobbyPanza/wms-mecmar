@page "/"
@page "/home"

@inject SessionService Session
@inject MockWmsService Wms
@inject NavigationManager Nav

<PageTitle>Menu — WMS Mecmar</PageTitle>

@* ─── Header operatore ───────────────────────────────────────────────────── *@
<MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:#1e2a40;border-radius:12px;">
    <div class="d-flex align-center gap-3">
        <MudAvatar Color="@(Session.IsSupervisor ? Color.Warning : Color.Primary)" Size="Size.Large">
            @Session.OperatorCode?.Substring(0, 2).ToUpper()
        </MudAvatar>
        <div>
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;line-height:1.2;">
                @Session.OperatorName
            </MudText>
            <MudText Typo="Typo.caption" Style="color:#7a9bb5;">
                @Session.OperatorCode · @(Session.IsSupervisor ? "Supervisore" : "Operatore")
            </MudText>
        </div>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Color="Color.Default"
                       Size="Size.Small"
                       OnClick="Logout"
                       title="Esci" />
    </div>
</MudPaper>

@* ─── KPI mini ────────────────────────────────────────────────────────────── *@
<div class="d-flex gap-2 mb-3" style="flex-wrap:wrap;">
    <MudChip T="string" Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" Size="Size.Small">
        @Wms.GetMovementsToday() mov. oggi
    </MudChip>
    <MudChip T="string" Icon="@Icons.Material.Filled.Engineering" Color="Color.Secondary" Size="Size.Small">
        @Wms.GetOpenProductionOrders() OdP aperti
    </MudChip>
    <MudChip T="string" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small">
        @Wms.GetLowStockArticles() sotto scorta
    </MudChip>
</div>

@* ─── Tile transazioni ────────────────────────────────────────────────────── *@
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">

    <WmsTile Icon="@Icons.Material.Filled.Search"
             Title="Interrogazione"
             TileColor="#4A9ECC"
             Route="/query" />

    <WmsTile Icon="@Icons.Material.Filled.Settings"
             Title="Configurazione"
             TileColor="#546E7A"
             Route="/config" />

    <WmsTile Icon="@Icons.Material.Filled.SwapHoriz"
             Title="Spostamento Semplice"
             TileColor="#E65100"
             Route="/move/simple" />

    <WmsTile Icon="@Icons.Material.Filled.ShoppingCart"
             Title="Spostamento Carrello"
             TileColor="#6A1B9A"
             Route="/move/cart"
             Badge="@(Session.Cart.Count > 0 ? Session.Cart.Count.ToString() : null)" />

    <WmsTile Icon="@Icons.Material.Filled.FormatListBulleted"
             Title="Lista Prelievo"
             TileColor="#2E7D32"
             Route="/list/pick" />

    <WmsTile Icon="@Icons.Material.Filled.PrecisionManufacturing"
             Title="Prelievo Produzione"
             TileColor="#B71C1C"
             Route="/production/pick" />

    <WmsTile Icon="@Icons.Material.Filled.LocalShipping"
             Title="Accettazione"
             TileColor="#00838F"
             Route="/acceptance" />

    <WmsTile Icon="@Icons.Material.Filled.Output"
             Title="Spedizione"
             TileColor="#1565C0"
             Route="/shipping" />

    <WmsTile Icon="@Icons.Material.Filled.Inventory"
             Title="Inventario"
             TileColor="#F57F17"
             Route="/inventory" />

    <WmsTile Icon="@Icons.Material.Filled.Edit"
             Title="Rettifiche"
             TileColor="#37474F"
             Route="/adjustments" />

</div>

@code {
    protected override void OnInitialized()
    {
        Session.SetPageTitle("WMS Mecmar");
    }

    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/login");
    }
}
