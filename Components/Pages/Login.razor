@page "/login"

@inject SessionService Session
@inject MockWmsService Wms
@inject ErpService Erp
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Login — WMS Mecmar</PageTitle>

<div style="min-height:100dvh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#161d2f;padding:24px;">

    <div style="background:#FFC200;border-radius:16px;padding:16px 28px;margin-bottom:24px;">
        <img src="/images/logo.png" alt="Mecmar" style="height:56px;display:block;" />
    </div>

    <MudText Typo="Typo.caption" Style="color:#8899aa;margin-bottom:32px;">Warehouse Management System</MudText>

    <MudPaper Elevation="8" Class="pa-6" Style="width:100%;max-width:360px;background:#1e2d3d;border-radius:16px;">

        <MudText Typo="Typo.subtitle1" Style="color:#93C0DC;margin-bottom:16px;font-weight:600;">
            @(Erp.IsConfigured ? "Accesso operatore" : "Seleziona operatore")
        </MudText>

        @if (Erp.IsConfigured)
        {
            <MudTextField @bind-Value="_selectedCode"
                          Label="Codice operatore"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Badge"
                          Class="mb-4"
                          AutoFocus="true"
                          OnKeyDown="OnCodeKeyDown" />
        }
        else
        {
            <MudSelect T="string"
                       @bind-Value="_selectedCode"
                       Label="Operatore"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       Class="mb-4">
                @foreach (var op in MockWmsService.Operators)
                {
                    <MudSelectItem Value="@op.Code">
                        @op.Code — @op.Name
                        @if (op.Role != "OP")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@op.Role</MudChip>
                        }
                    </MudSelectItem>
                }
            </MudSelect>
        }

        @if (_pinRequired)
        {
            <MudTextField @bind-Value="_pin"
                          Label="PIN"
                          InputType="@(_showPin ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPin ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPin = !_showPin"
                          MaxLength="8"
                          Class="mb-4"
                          OnKeyDown="OnPinKeyDown" />
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Login"
                   OnClick="@(_pinRequired ? DoLogin : CheckPinThenProceedAsync)"
                   Disabled="@_loading"
                   Style="height:52px;font-size:1rem;font-weight:700;">
            @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
            else { <span>ACCEDI</span> }
        </MudButton>
    </MudPaper>

    <MudText Typo="Typo.caption" Style="color:#445566;margin-top:24px;">
        v1.0-MVP · Mecmar S.p.A.
    </MudText>
</div>

@code {
    private string _selectedCode = "";
    private string _pin = "";
    private bool _showPin;
    private bool _loading;
    private bool _pinRequired = true;

    protected override void OnInitialized()
    {
        Session.SetPageTitle("WMS Mecmar");
        if (Session.IsLoggedIn)
            Nav.NavigateTo("/home");

        // Pre-seleziona il primo operatore solo in modalità mock
        if (!Erp.IsConfigured && MockWmsService.Operators.Count > 0)
            _selectedCode = MockWmsService.Operators[0].Code;
    }

    private async Task OnCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CheckPinThenProceedAsync();
    }

    private async Task OnPinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    // Controlla se il PIN è richiesto; se no, esegue subito il login.
    private async Task CheckPinThenProceedAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedCode)) return;
        if (Erp.IsConfigured)
            _pinRequired = await Erp.OperatorRequiresPinAsync(_selectedCode);
        if (!_pinRequired)
            await DoLogin();
        // altrimenti l'utente deve compilare il PIN e cliccare ACCEDI
    }

    private async Task DoLogin()
    {
        if (string.IsNullOrEmpty(_selectedCode)) return;
        if (_pinRequired && string.IsNullOrEmpty(_pin)) return;
        _loading = true;

        bool ok; string? name, role, groupCode;

        if (Erp.IsConfigured)
        {
            try
            {
                (ok, name, role, groupCode) = await Erp.TryLoginAsync(_selectedCode, _pin);
            }
            catch
            {
                Snackbar.Add("Errore connessione DB — riprova", Severity.Error);
                _loading = false;
                return;
            }
        }
        else
        {
            await Task.Delay(300); // simula latenza mock
            (ok, name, role) = Wms.TryLogin(_selectedCode, _pin);
            groupCode = role;
        }

        if (ok)
        {
            Session.Login(_selectedCode, name!, role!, groupCode ?? "");
            await JS.InvokeVoidAsync("localStorage.setItem", "wms-op-code",  _selectedCode);
            await JS.InvokeVoidAsync("localStorage.setItem", "wms-op-name",  name!);
            await JS.InvokeVoidAsync("localStorage.setItem", "wms-op-role",  role!);
            await JS.InvokeVoidAsync("localStorage.setItem", "wms-op-group", groupCode ?? "");
            if (Session.NodeReady)
                _ = Erp.UpdateNodeLoginAsync(Session.NodeId, _selectedCode);
            Nav.NavigateTo("/home");
        }
        else
        {
            Snackbar.Add("Credenziali non corrette", Severity.Error);
            _pin = "";
        }
        _loading = false;
    }
}
