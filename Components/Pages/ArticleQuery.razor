@page "/query/article"

@inject SessionService Session
@inject MockWmsService Wms
@inject ISnackbar Snackbar

<PageTitle>Interrogazione Articolo</PageTitle>

@* ─── Scan input ─────────────────────────────────────────────────────────── *@
<BarcodeInput Label="Codice articolo" Placeholder="Es. BRU-2000"
              OnCodeScanned="OnCodeScanned" AutoFocus="true" />

@* ─── Risultato ──────────────────────────────────────────────────────────── *@
@if (_loading)
{
    <div class="d-flex justify-center mt-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">
        Articolo <strong>@_lastQuery</strong> non trovato.
    </MudAlert>
}
else if (_article is not null)
{
    @* ─── Header articolo ───────────────────────────────────────────────── *@
    <MudPaper Elevation="3" Class="pa-3 mt-3" Style="border-radius:12px;">
        <div class="d-flex gap-3 align-start">

            @* Immagine fissa *@
            <div class="wms-article-image">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                         Style="font-size:52px;color:#5B9BD5;" />
                <MudText Typo="Typo.caption" Style="color:#64748B;margin-top:4px;font-size:0.65rem;">
                    img. articolo
                </MudText>
            </div>

            <div class="flex-grow-1" style="min-width:0;">
                <div class="d-flex align-center gap-1 mb-1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="wms-code-chip">
                        @_article.Code
                    </MudChip>
                    <ArticleInfoButton ArticleCode="@_article.Code" />
                </div>
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;line-height:1.3;word-break:break-word;">
                    @_article.Description
                </MudText>
                <MudText Typo="Typo.caption" Style="color:#8899aa;">
                    UM: @_article.UoM
                </MudText>

                <div class="d-flex align-center mt-2 gap-2">
                    <MudText Typo="Typo.caption" Style="color:#94A3B8;">Giacenza totale:</MudText>
                    <StockBadge Quantity="@_article.TotalStock"
                                MinStock="@_article.MinStock"
                                UoM="@_article.UoM"
                                Size="Size.Medium" />
                </div>
            </div>
        </div>
    </MudPaper>

    @* ─── Tabs locazioni / movimenti ──────────────────────────────────────── *@
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true"
             Class="mt-3">

        <MudTabPanel Text="Locazioni" Icon="@Icons.Material.Filled.LocationOn">
            @if (_article.Locations.Count == 0)
            {
                <MudText Class="pa-3" Style="color:#777;">Nessuna locazione abbinata.</MudText>
            }
            else
            {
                @foreach (var loc in _article.Locations)
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-2" Style="border-radius:8px;background:#242e42;">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <div class="d-flex align-center gap-2">
                                    <MudText Style="font-weight:700;font-family:monospace;">
                                        @loc.WarehouseCode / @loc.LocationCode
                                    </MudText>
                                    @if (loc.IsMainWithdrawal)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">PRINCIPALE</MudChip>
                                    }
                                    else if (loc.Priority == "S")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">SEC.</MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Style="color:#94A3B8;">
                                    @loc.LocationDesc
                                </MudText>
                            </div>
                            <StockBadge Quantity="@loc.Quantity"
                                        MinStock="@loc.MinQty"
                                        UoM="@_article.UoM"
                                        Size="Size.Medium" />
                        </div>
                        @if (loc.MaxQty > 0)
                        {
                            <MudProgressLinear Value="@((double)(loc.Quantity / loc.MaxQty * 100))"
                                              Color="Color.Primary" Rounded="true"
                                              Size="Size.Small" Class="mt-2" />
                        }
                    </MudPaper>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Movimenti" Icon="@Icons.Material.Filled.History">
            @if (_article.RecentMovements.Count == 0)
            {
                <MudText Class="pa-3" Style="color:#777;">Nessun movimento recente.</MudText>
            }
            else
            {
                @foreach (var mov in _article.RecentMovements)
                {
                    <MudPaper Elevation="1" Class="pa-2 mb-1" Style="border-radius:6px;background:#202736;">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    @mov.CausalCode — @mov.CausalDesc
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color:#94A3B8;">
                                    @mov.Timestamp.ToString("dd/MM/yy HH:mm") · @mov.OperatorCode · @mov.WarehouseCode/@mov.LocationCode
                                </MudText>
                            </div>
                            <MudText Style="@($"font-weight:700;font-size:1.1rem;color:{(mov.Quantity >= 0 ? "#4FAB5B" : "#E05252")}")">
                                @(mov.Quantity >= 0 ? "+" : "")@mov.Quantity.ToString("0.###")
                            </MudText>
                        </div>
                    </MudPaper>
                }
            }
        </MudTabPanel>

    </MudTabs>
}
else
{
    <MudText Class="mt-4 text-center" Style="color:#64748B;">
        Scansiona o digita il codice articolo
    </MudText>
}

@code {
    private ArticleDto? _article;
    private bool _loading;
    private bool _notFound;
    private string _lastQuery = "";

    protected override void OnInitialized()
    {
        Session.SetPageTitle("Interrogazione Articolo");
    }

    private async Task OnCodeScanned(string code)
    {
        _lastQuery = code;
        _loading = true;
        _notFound = false;
        _article = null;
        StateHasChanged();

        await Task.Delay(200); // simula latenza API
        _article = Wms.GetArticle(code);
        _notFound = _article is null;
        _loading = false;
    }
}
