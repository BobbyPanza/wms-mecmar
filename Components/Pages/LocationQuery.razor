@page "/query/location"

@inject SessionService Session
@inject MockWmsService Wms

<PageTitle>Interrogazione Locazione</PageTitle>

<BarcodeInput Label="Codice locazione" Placeholder="Es. A-01-01 oppure TRANS-01"
              OnCodeScanned="OnCodeScanned" AutoFocus="true" />

@if (_loading)
{
    <div class="d-flex justify-center mt-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">
        Locazione <strong>@_lastQuery</strong> non trovata.
    </MudAlert>
}
else if (_location is not null)
{
    @* ─── Header locazione ───────────────────────────────────────────────── *@
    <MudPaper Elevation="3" Class="pa-3 mt-3" Style="border-radius:12px;background:#1e2d20;">
        <div class="d-flex align-center gap-3 mb-2">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                     Style="font-size:2.5rem;color:#00838F;" />
            <div>
                <MudText Style="font-family:monospace;font-weight:700;font-size:1.3rem;letter-spacing:0.05em;">
                    @_location.WarehouseCode / @_location.LocationCode
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#8aaa8a;">@_location.LocationDesc</MudText>
            </div>
        </div>

        <MudDivider Class="mb-2" />

        <div class="d-flex gap-3 flex-wrap">
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Warehouse">
                @_location.WarehouseDesc
            </MudChip>
            @if (_location.Lane.HasValue)
            {
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Grid3x3">
                    C@(_location.Lane) / S@(_location.HPos) / R@(_location.VPos)
                </MudChip>
            }
            @if (_location.IsAcceptance)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">TRANSITO</MudChip>
            }
            @if (_location.IsFiscal)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">FISCALE</MudChip>
            }
        </div>
    </MudPaper>

    @* ─── Tabs contenuto / movimenti ──────────────────────────────────────── *@
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true"
             Class="mt-3">

        <MudTabPanel Text="@($"Contenuto ({_location.Contents.Count})")"
                     Icon="@Icons.Material.Filled.Inventory">
            @if (_location.Contents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">Locazione vuota.</MudAlert>
            }
            else
            {
                @foreach (var item in _location.Contents)
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-2" Style="border-radius:8px;">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <div class="d-flex align-center gap-1">
                                    <MudText Style="font-weight:700;font-family:monospace;">@item.ArticleCode</MudText>
                                    <ArticleInfoButton ArticleCode="@item.ArticleCode" />
                                </div>
                                <MudText Typo="Typo.body2" Style="color:#94A3B8;word-break:break-word;">
                                    @item.ArticleDesc
                                </MudText>
                                @if (item.Priority == "P")
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="mt-1">LOC. PRINCIPALE</MudChip>
                                }
                            </div>
                            <StockBadge Quantity="@item.Quantity" MinStock="0" UoM="@item.UoM" Size="Size.Large" />
                        </div>
                    </MudPaper>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Movimenti" Icon="@Icons.Material.Filled.History">
            @foreach (var mov in _location.RecentMovements)
            {
                <MudPaper Elevation="1" Class="pa-2 mb-1" Style="border-radius:6px;background:#202736;">
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">
                                @mov.CausalCode — @mov.CausalDesc
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color:#94A3B8;">
                                @mov.Timestamp.ToString("dd/MM/yy HH:mm") · @mov.OperatorCode · @mov.DocumentRef
                            </MudText>
                        </div>
                        <MudText Style="@($"font-weight:700;font-size:1.1rem;color:{(mov.Quantity >= 0 ? "#4FAB5B" : "#E05252")}")">
                            @(mov.Quantity >= 0 ? "+" : "")@mov.Quantity.ToString("0.###")
                        </MudText>
                    </div>
                </MudPaper>
            }
        </MudTabPanel>

    </MudTabs>
}
else
{
    <MudText Class="mt-4 text-center" Style="color:#64748B;">
        Scansiona o digita il codice locazione
    </MudText>
}

@code {
    private LocationDto? _location;
    private bool _loading;
    private bool _notFound;
    private string _lastQuery = "";

    protected override void OnInitialized()
    {
        Session.SetPageTitle("Interrogazione Locazione");
    }

    private async Task OnCodeScanned(string code)
    {
        _lastQuery = code;
        _loading = true;
        _notFound = false;
        _location = null;
        StateHasChanged();
        await Task.Delay(200);
        _location = Wms.GetLocation("MAG", code);
        _notFound = _location is null;
        _loading = false;
    }
}
