@inject LogicService Logic
@inject PrintService Printer
@inject SessionService Session
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Stampa — @Session.PrintContext</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center my-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else if (_templates.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                Nessun template configurato per il contesto <strong>@Session.PrintContext</strong>.<br />
                Aggiungere righe in <code>WMS_PrintTemplate</code> con Context = '@Session.PrintContext'.
            </MudAlert>
        }
        else
        {
            @* ─── A) Selezione report ─────────────────────────────────────────── *@
            @if (_templates.Count > 1)
            {
                <MudSelect T="PrintTemplate" Value="_selected" ValueChanged="OnTemplateChangedAsync"
                           Label="Report"
                           Variant="Variant.Outlined" Class="mb-3"
                           ToStringFunc="@(t => t?.Name ?? string.Empty)">
                    @foreach (var t in _templates)
                    {
                        <MudSelectItem Value="@t">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:#94A3B8;">
                    Report: <strong style="color:#E2E8F0;">@_selected?.Name</strong>
                </MudText>
            }

            @if (_selected is not null)
            {
                @* ─── B) Stampante ───────────────────────────────────────────────── *@
                <MudAutocomplete T="string" @bind-Value="_printerName"
                                 Label="Stampante"
                                 Variant="Variant.Outlined" Class="mb-2"
                                 SearchFunc="SearchPrinters"
                                 Immediate="true" CoerceValue="true"
                                 AdornmentIcon="@Icons.Material.Filled.Print"
                                 Adornment="Adornment.Start"
                                 HelperText="@PrinterHelperText" />

                @* ─── Parametri ──────────────────────────────────────────────────── *@
                @foreach (var p in _selected.Params.OrderBy(x => x.SortOrder))
                {
                    var isAuto = p.AutoFillKey is not null &&
                                 Session.PrintAutoFill.ContainsKey(p.AutoFillKey);
                    <MudTextField @bind-Value="_paramValues[p.ParamName]"
                                  Label="@p.Label"
                                  Variant="Variant.Outlined"
                                  Class="mb-2"
                                  ReadOnly="@isAuto"
                                  Adornment="@(isAuto ? Adornment.End : Adornment.None)"
                                  AdornmentIcon="@(isAuto ? Icons.Material.Filled.AutoAwesome : null)"
                                  AdornmentColor="Color.Success" />
                }

                @* ─── C) Numero etichette ────────────────────────────────────────── *@
                <MudNumericField @bind-Value="_copies"
                                 Label="Numero etichette"
                                 Variant="Variant.Outlined"
                                 Min="1" Max="999"
                                 Class="mb-2" />

                @if (!Printer.IsConfigured)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        Servizio stampa non configurato — impostare <code>PrintService:IntesiPrinterManagerUrl</code> o <code>PrintService:BaseUrl</code> in appsettings.
                    </MudAlert>
                }
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Annulla</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Print"
                   Disabled="@(_selected is null || _printing || !Printer.IsConfigured)"
                   OnClick="DoPrint">
            @if (_printing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
            else            { <span>STAMPA</span> }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private List<PrintTemplate>      _templates   = [];
    private PrintTemplate?           _selected;
    private Dictionary<string, string> _paramValues = new();
    private List<string>             _printers    = [];
    private string?                  _printerName;
    private int  _copies  = 1;
    private bool _loading = true;
    private bool _printing;

    private string PrinterHelperText =>
        _printerName == _selected?.PrinterName || _printerName == Printer.DefaultPrinterName
            ? "Default aziendale"
            : "Default terminale (salvato in questo browser)";

    protected override async Task OnInitializedAsync()
    {
        _printers = Printer.GetInstalledPrinters().ToList();

        if (!Logic.IsConfigured) { _loading = false; return; }

        try { _templates = await Logic.GetPrintTemplatesAsync(Session.PrintContext); }
        catch { _templates = []; }

        if (_templates.Count > 0)
        {
            _selected = _templates[0];
            BuildParamValues();
            await LoadSavedPrinterAsync();
        }

        if (Session.PrintAutoFill.TryGetValue("COPIES", out var copiesStr)
            && int.TryParse(copiesStr, out var copiesVal) && copiesVal > 0)
            _copies = copiesVal;

        _loading = false;
    }

    private async Task OnTemplateChangedAsync(PrintTemplate? t)
    {
        _selected = t;
        BuildParamValues();
        await LoadSavedPrinterAsync();
    }

    private void BuildParamValues()
    {
        _paramValues = new();
        if (_selected is null) return;
        foreach (var p in _selected.Params)
        {
            var val = "";
            if (p.AutoFillKey is not null && Session.PrintAutoFill.TryGetValue(p.AutoFillKey, out var af))
                val = af;
            _paramValues[p.ParamName] = val;
        }
    }

    // Carica la stampante salvata per questo report dal localStorage.
    // Priorità: localStorage > template.PrinterName > default config
    private async Task LoadSavedPrinterAsync()
    {
        if (_selected is null) return;
        var storageKey = $"wms-printer-{_selected.ReportName}";
        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", storageKey);
        _printerName = !string.IsNullOrEmpty(saved) ? saved
                     : _selected.PrinterName ?? Printer.DefaultPrinterName ?? "";
    }

    private Task<IEnumerable<string>> SearchPrinters(string? value, CancellationToken _)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<string>>(_printers);
        return Task.FromResult<IEnumerable<string>>(
            _printers.Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task DoPrint()
    {
        if (_selected is null) return;
        _printing = true;

        // Salva la stampante scelta per questo terminale/report
        if (!string.IsNullOrEmpty(_printerName))
            await JS.InvokeVoidAsync("localStorage.setItem",
                $"wms-printer-{_selected.ReportName}", _printerName);

        var (ok, msg) = await Printer.PrintAsync(
            _selected,
            Session.OperatorCode ?? "",
            Session.PageTitle,
            new Dictionary<string, string>(_paramValues),
            _copies,
            string.IsNullOrWhiteSpace(_printerName) ? null : _printerName);

        if (ok)
        {
            Snackbar.Add(msg, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(msg, Severity.Error);
        }

        _printing = false;
    }

    private void Cancel() => MudDialog.Cancel();
}
