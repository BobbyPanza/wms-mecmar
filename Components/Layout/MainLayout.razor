@inherits LayoutComponentBase
@inject SessionService Session
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ErpService Erp
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Dense="true" Fixed="true" Elevation="4" Style="background:#ffc200;">
        @if (IsHomePage)
        {
            <img src="/images/logo.png" alt="Mecmar" style="height:28px;display:block;margin-left:4px;" />
            <MudSpacer />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Style="color:#1e1f1f;"
                           Size="Size.Medium"
                           OnClick="GoBack"
                           title="Indietro" />
            <MudText Class="wms-appbar-title ml-2 flex-grow-1" Style="color:#1e1f1f;font-weight:700;">@Session.PageTitle</MudText>
        }

        @if (Session.IsLoggedIn && !string.IsNullOrEmpty(Session.PrintContext))
        {
            <MudIconButton Icon="@Icons.Material.Filled.Print"
                           Style="color:#1e1f1f;"
                           Size="Size.Medium"
                           OnClick="OpenPrintDialog"
                           title="Stampa" />
        }

        @if (Session.IsLoggedIn)
        {
            <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudButton EndIcon="@Icons.Material.Filled.ArrowDropDown"
                               Style="color:#1e1f1f;text-transform:none;font-weight:600;min-width:0;"
                               Size="Size.Small"
                               OnClick="@context.ToggleAsync">
                        @Session.OperatorCode
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem OnClick='() => Nav.NavigateTo("/config")'>
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mr-2" />Configurazioni
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="Logout">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-2" />Logout
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="px-2 py-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Inject] private ILogger<MainLayout> _log { get; set; } = default!;

    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary                = "#ffc200",   // Mikado yellow
            PrimaryDarken          = "#cc9b00",
            PrimaryLighten         = "#ffd740",
            PrimaryContrastText    = "#1e1f1f",   // dark text on yellow buttons
            Secondary              = "#23A6F0",   // Pictor blue
            SecondaryContrastText  = "#ffffff",
            Success                = "#00C853",   // Dark pastel green
            SuccessContrastText    = "#ffffff",
            Warning                = "#FF8C00",   // Orange
            WarningContrastText    = "#ffffff",
            Error                  = "#FF1919",   // Red
            ErrorContrastText      = "#ffffff",
            Info                   = "#23A6F0",
            InfoContrastText       = "#ffffff",
            Background             = "#1e1f1f",   // Eerie black
            BackgroundGray         = "#222222",
            Surface                = "#252525",
            DrawerBackground       = "#1a1a1a",
            AppbarBackground       = "#ffc200",
            AppbarText             = "#1e1f1f",
            TextPrimary            = "#f0f0f0",
            TextSecondary          = "#a1a1a1",   // Cadet gray
            ActionDefault          = "#888888",
            Divider                = "#3a3a3a",
        }
    };

    private bool IsHomePage  => Nav.Uri == Nav.BaseUri || Nav.Uri.TrimEnd('/').EndsWith("/home");
    private bool IsLoginPage => Nav.Uri.TrimEnd('/').EndsWith("/login");

    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Inizializza nodo dispositivo (A_NOD) — una volta per circuito
        if (!Session.NodeReady)
            await InitNodeAsync();

        if (!Session.IsLoggedIn)
            await TryRestoreSessionAsync();

        if (!Session.IsLoggedIn && !IsLoginPage)
            Nav.NavigateTo("/login");
    }

    private async Task InitNodeAsync()
    {
        try
        {
            const string StorageKey = "wms-node-id";

            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            int.TryParse(stored, out var cdnodFromStorage);

            // Nome dispositivo: userAgent troncato a 30 caratteri
            var deviceName = await JS.InvokeAsync<string>("eval",
                "navigator.userAgent.substring(0,30)");

            var cdnod = await Erp.RegisterOrGetNodeAsync(cdnodFromStorage, deviceName);

            if (cdnod != cdnodFromStorage)
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, cdnod.ToString());

            Session.SetNodeId(cdnod);
        }
        catch (Exception ex)
        {
            // Nodo non critico — il prelievo produzione lo richiederà, le altre funzioni no
            _log.LogWarning(ex, "InitNodeAsync: impossibile registrare nodo A_NOD");
        }
    }

    private async Task TryRestoreSessionAsync()
    {
        try
        {
            var code = await JS.InvokeAsync<string?>("localStorage.getItem", "wms-op-code");
            var name = await JS.InvokeAsync<string?>("localStorage.getItem", "wms-op-name");
            var role = await JS.InvokeAsync<string?>("localStorage.getItem", "wms-op-role");
            if (!string.IsNullOrEmpty(code) && !string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(role))
                Session.Login(code, name, role);
        }
        catch (Exception ex)
        {
            _log.LogWarning(ex, "TryRestoreSessionAsync: impossibile leggere localStorage");
        }
    }

    private void GoBack() => Nav.NavigateTo("/home");

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "wms-op-code");
        await JS.InvokeVoidAsync("localStorage.removeItem", "wms-op-name");
        await JS.InvokeVoidAsync("localStorage.removeItem", "wms-op-role");
        Session.Logout();
        Nav.NavigateTo("/login");
    }

    private Task OpenPrintDialog() =>
        DialogService.ShowAsync<PrintDialog>("Stampa");

    public void Dispose() => Session.OnChange -= StateHasChanged;
}
